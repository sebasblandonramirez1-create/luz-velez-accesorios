# Copia este archivo como .env.local y rellena los valores. Nunca subas .env.local al repositorio.

# --- Supabase (Proyecto > Settings > API) ---
# URL pública del proyecto, por ejemplo https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública («anon» o «publishable»). Es segura en el navegador porque las
# políticas de seguridad a nivel de fila (RLS) limitan lo que puede hacer.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio («service_role» o «secret»). SOLO en el servidor y en GitHub
# Actions (respaldos, tareas programadas). Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Aplicación ---
# URL pública donde vive la aplicación (para enlaces de correo y catálogo público).
NEXT_PUBLIC_APP_URL=http://localhost:3000
